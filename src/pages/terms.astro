---
import '../styles/global.css';
import { pricing } from '../data/pricing';

const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

const lastUpdated = '7 May 2026';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <title>Terms &amp; Conditions — Bytecode Consulting</title>
    <meta name="description" content="Terms of service for Bytecode Consulting's small-business website service." />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <header class="border-b border-ink/5">
      <div class="container-page flex items-center justify-between h-16 md:h-20">
        <a href="/" class="flex items-baseline gap-2.5">
          <span class="font-display text-xl md:text-2xl font-semibold tracking-tight text-ink">
            Bytecode <span class="text-brass">Studio</span>
          </span>
          <span class="hidden md:inline text-[0.65rem] uppercase tracking-[0.22em] text-muted">
            By Bytecode Consulting
          </span>
        </a>
        <a href="/" class="text-sm text-muted hover:text-brass transition-colors">← Back to home</a>
      </div>
    </header>

    <main class="section-pad">
      <article class="container-page max-w-3xl">
        <p class="eyebrow">Legal</p>
        <h1 class="mt-4 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-ink">
          Terms &amp; conditions.
        </h1>
        <p class="mt-6 text-base text-muted">Last updated {lastUpdated}</p>

        <div class="mt-12 space-y-10 text-base text-ink leading-relaxed">

          <section>
            <p>
              These are the terms that apply when you buy or use the small-business website
              service from <strong>Bytecode Consulting Limited</strong> ("we", "us"). When you sign
              up, you agree to them. They're written in plain English on purpose.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">1. What we provide</h2>
            <ul class="space-y-2 list-disc pl-5">
              <li>A custom-designed, mobile-first marketing website for your business.</li>
              <li>A custom domain name (we register and renew it for you).</li>
              <li>Hosting, SSL/HTTPS and DNS configuration.</li>
              <li>Search-engine setup (LocalBusiness schema, sitemap, meta tags).</li>
              <li>Privacy-respecting analytics, an installable PWA experience, and Open Graph link previews.</li>
              <li>Privacy and terms boilerplate written for your business.</li>
              <li>Ongoing content updates within reason while you're a paying customer.</li>
              <li>Real human support, by message or in person in Dartford.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">2. Pricing &amp; billing</h2>
            <ul class="space-y-2 list-disc pl-5">
              <li>Setup fee is paid up front and covers the build, the domain registration, the launch and the items above.</li>
              <li>Monthly (or annual) fee covers ongoing hosting, domain renewal, content updates and support.</li>
              <li>The <strong>Founder</strong> price (£99 setup + £19/month) is locked in for the first five paying customers, for as long as their service stays continuously active. After the first five, new customers move to the Standard rate (£149 + £29/month).</li>
              <li>Annual payment, where chosen, is billed up front and is non-refundable for the period concerned, except as required by UK consumer law.</li>
              <li>All prices include UK VAT where applicable.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">3. Cancellation</h2>
            <ul class="space-y-2 list-disc pl-5">
              <li>You may cancel any month, no minimum term, no exit fees.</li>
              <li>On cancellation, your site is taken offline within 7 days and we stop charging you.</li>
              <li>Your domain is transferred to you at-cost (typically £8–£15 depending on the registrar). You can also point it elsewhere yourself.</li>
              <li>You keep all your content (photos, copy, customer messages received via the form).</li>
              <li>Annual prepayments are non-refundable for the period already paid for.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">4. Your obligations</h2>
            <ul class="space-y-2 list-disc pl-5">
              <li>You provide accurate information about your business (name, address, hours, services, prices).</li>
              <li>You own (or have permission to use) any photos, logos and content you provide.</li>
              <li>You don't ask us to publish illegal, misleading or defamatory content.</li>
              <li>You pay your monthly/annual fee on time. If a payment fails, we'll let you know. After 14 days unpaid, we may pause your site.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">5. Who owns what</h2>
            <ul class="space-y-2 list-disc pl-5">
              <li><strong>You own</strong> your content — copy, photos, brand, customer data, and the domain name.</li>
              <li><strong>We own</strong> the underlying template, code, and design system. You have a licence to use it for your business while you're a paying customer.</li>
              <li>If you cancel, we may keep an anonymised reference to having built your site (in our portfolio). You can opt out of being referenced by emailing us.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">6. What's not included</h2>
            <p>
              The following sit outside this service. We can quote separately for any of them:
            </p>
            <ul class="mt-3 space-y-2 list-disc pl-5">
              <li>E-commerce / online ordering systems.</li>
              <li>Custom photoshoots (£150 add-on, see pricing page).</li>
              <li>Booking system integrations (£150 add-on).</li>
              <li>Marketing campaigns or paid advertising.</li>
              <li>Social media management.</li>
              <li>Logo or branding from scratch (£200 add-on).</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">7. Our liability</h2>
            <p>
              We do our best to keep your site online, but we're not liable for losses arising
              from outages outside our control (e.g. our hosting provider going down, your
              domain registrar). Our maximum liability to you is limited to the amount you paid
              us in the previous 12 months.
            </p>
            <p class="mt-3">
              Nothing in these terms limits liability for fraud, death or personal injury caused
              by negligence, or any other liability that cannot be limited under UK law.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">8. Changes</h2>
            <p>
              We may update these terms occasionally. If we make a material change, we'll email
              you at least 30 days before it applies. You can cancel any time without penalty if
              you don't like a change.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">9. Governing law</h2>
            <p>
              These terms are governed by the laws of England &amp; Wales. Any disputes will be
              handled in the courts of England &amp; Wales.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">10. Contact</h2>
            <p>
              Questions about these terms? Email
              <a href={`mailto:${pricing.brand.email}`} class="text-brass hover:text-brass-dark underline-offset-2 hover:underline">{pricing.brand.email}</a>.
            </p>
          </section>
        </div>
      </article>
    </main>

    <footer class="bg-ink text-cream">
      <div class="container-page py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-cream/60">
        <p>© {new Date().getFullYear()} {pricing.brand.name}. All rights reserved.</p>
        <div class="flex gap-5">
          <a href="/" class="hover:text-brass-light transition-colors">Home</a>
          <a href="/privacy" class="hover:text-brass-light transition-colors">Privacy</a>
          <a href="/terms" class="hover:text-brass-light transition-colors">Terms</a>
        </div>
      </div>
    </footer>
  </body>
</html>
