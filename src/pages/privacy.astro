---
import '../styles/global.css';
import { pricing } from '../data/pricing';

const base = import.meta.env.BASE_URL;
const asset = (p: string) => `${base}/${p}`.replace(/\/+/g, '/');

const lastUpdated = '7 May 2026';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <title>Privacy Policy — Bytecode Consulting</title>
    <meta name="description" content="How Bytecode Consulting handles your personal data." />
    <meta name="theme-color" content="#faf7f2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <header class="border-b border-ink/5">
      <div class="container-page flex items-center justify-between h-16 md:h-20">
        <a href="/" class="flex items-baseline gap-2.5">
          <span class="font-display text-xl md:text-2xl font-semibold tracking-tight text-ink">
            Bytecode <span class="text-brass">Studio</span>
          </span>
          <span class="hidden md:inline text-[0.65rem] uppercase tracking-[0.22em] text-muted">
            By Bytecode Consulting
          </span>
        </a>
        <a href="/" class="text-sm text-muted hover:text-brass transition-colors">← Back to home</a>
      </div>
    </header>

    <main class="section-pad">
      <article class="container-page max-w-3xl">
        <p class="eyebrow">Legal</p>
        <h1 class="mt-4 font-display text-4xl md:text-5xl lg:text-6xl leading-[1.05] text-ink">
          Privacy policy.
        </h1>
        <p class="mt-6 text-base text-muted">Last updated {lastUpdated}</p>

        <div class="mt-12 space-y-10 text-base text-ink leading-relaxed">

          <section>
            <p>
              This privacy notice explains how <strong>Bytecode Consulting Limited</strong> ("we",
              "us", "our") collects and uses your personal data when you visit
              <a href="/" class="text-brass hover:text-brass-dark underline-offset-2 hover:underline">our website</a>
              or contact us through any of the forms listed on it. We're a UK company and we
              follow UK GDPR.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">What we collect</h2>
            <ul class="space-y-2 list-disc pl-5">
              <li><strong>Information you give us</strong> — your name, business name, business type, phone number, email address and anything you write in the "tell us about your business" field of the apply form.</li>
              <li><strong>Information collected automatically</strong> — basic, privacy-respecting visit analytics (which page, country, referrer, screen size). We do not use Google Analytics or set marketing cookies.</li>
              <li><strong>Server logs</strong> — IP address and request metadata, retained for up to 30 days, used only to investigate abuse and outages.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">Why we collect it</h2>
            <ul class="space-y-2 list-disc pl-5">
              <li>To reply to your enquiry and discuss whether we can build you a website.</li>
              <li>To deliver the service if you become a customer (build your site, host it, support you).</li>
              <li>To understand which parts of our pricing page work and which don't, in aggregate.</li>
              <li>To meet our legal obligations (tax records, invoicing).</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">Who we share it with</h2>
            <p>
              We don't sell your data, ever. We do share specific information with the
              suppliers we use to actually run the service:
            </p>
            <ul class="mt-3 space-y-2 list-disc pl-5">
              <li><strong>Formspree</strong> — receives submissions of the apply form on your behalf and forwards them to our inbox.</li>
              <li><strong>GitHub Pages / Cloudflare</strong> — hosts the site and serves it to visitors.</li>
              <li><strong>GoDaddy</strong> — registers and renews domain names.</li>
              <li><strong>Stripe</strong> (only if you become a paying customer) — handles billing.</li>
            </ul>
            <p class="mt-3">
              All of these providers have their own privacy notices and process your data under
              standard contractual safeguards.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">How long we keep it</h2>
            <p>
              Form submissions stay in our inbox for as long as the conversation is useful, and
              are deleted on request. Customer records are kept for 7 years after a customer
              relationship ends — that's an HMRC requirement for invoicing data. Server logs are
              kept for 30 days.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">Your rights under UK GDPR</h2>
            <p>You can:</p>
            <ul class="mt-3 space-y-2 list-disc pl-5">
              <li>Ask for a copy of the personal data we hold on you.</li>
              <li>Ask us to correct anything inaccurate.</li>
              <li>Ask us to delete your data ("right to be forgotten") — subject to the 7-year HMRC retention for paying customers.</li>
              <li>Object to or restrict our processing.</li>
              <li>Complain to the UK ICO at <a href="https://ico.org.uk" target="_blank" rel="noopener" class="text-brass hover:text-brass-dark underline-offset-2 hover:underline">ico.org.uk</a>.</li>
            </ul>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">Cookies</h2>
            <p>
              This site does not set marketing or tracking cookies. The only cookies you may
              encounter are technical cookies set by your browser to remember session state, and
              none of them are used to identify you.
            </p>
          </section>

          <section>
            <h2 class="font-display text-2xl text-ink mb-3">Get in touch</h2>
            <p>
              For any privacy question, or to exercise any of the rights above, email
              <a href={`mailto:${pricing.brand.email}`} class="text-brass hover:text-brass-dark underline-offset-2 hover:underline">{pricing.brand.email}</a>.
              We aim to reply within five working days.
            </p>
          </section>
        </div>
      </article>
    </main>

    <footer class="bg-ink text-cream">
      <div class="container-page py-8 flex flex-col md:flex-row md:items-center md:justify-between gap-3 text-xs text-cream/60">
        <p>© {new Date().getFullYear()} {pricing.brand.name}. All rights reserved.</p>
        <div class="flex gap-5">
          <a href="/" class="hover:text-brass-light transition-colors">Home</a>
          <a href="/privacy" class="hover:text-brass-light transition-colors">Privacy</a>
          <a href="/terms" class="hover:text-brass-light transition-colors">Terms</a>
        </div>
      </div>
    </footer>
  </body>
</html>
